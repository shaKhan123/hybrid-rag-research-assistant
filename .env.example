QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# Both providers are wired up as interchangeable LLM backends (see
# LLM_PROVIDER in src/config.py) — set whichever one LLM_PROVIDER points
# at. Setting both lets you flip providers with just an env var change
# if one's free-tier quota gets rate-limited.
GROQ_API_KEY=your-groq-api-key
GOOGLE_API_KEY=your-gemini-api-key

# LLM_PROVIDER=groq   # or "gemini" — defaults to "groq" if unset

# Unused by the current pipeline — kept only for an easy revert to Anthropic.
# ANTHROPIC_API_KEY=your-anthropic-api-key
